clear_content_legend_slices                    = Content (slices)
clear_content_languages_selection              = Select languages
clear_content_languages_selection_help         = The selection applies to both language-specific actions. “Delete content in these languages” removes current and historical slices from all articles in the selected languages. If only one language exists, it is used automatically.
clear_content_slices_languages                 = Content in selected languages
clear_content_delete_slices_language           = Delete content in these languages
clear_content_slices_article_language          = Select articles
clear_content_articles_select                  = Select articles
clear_content_slices_article_language_help     = Current and historical slices in the selected articles are removed only for the selected languages. The articles themselves and their content in other languages remain intact.
clear_content_delete_slices_article_language   = Delete content from selected articles
clear_content_preview_article_language         = Article “{0}” [ID {1}], languages: {2}
clear_content_preview_languages                = Selected languages: {0}
clear_content_slices_modules                   = Content from selected modules
clear_content_slices_modules_help              = All standalone slices and detected nested Gridblock content of the selected modules are deleted from every article, language and slice history. The modules themselves remain intact.
clear_content_delete_slices_modules            = Delete content from these modules
clear_content_preview_module                   = {0} [module {1}]: {2} standalone slices, {3} nested Gridblock items, {4} historical Gridblock items

clear_content_legend_structure                 = Categories and articles
clear_content_actions                          = Actions
clear_content_structure_info                   = This action is independent of the language selection and deletes the site structure in all languages. The site start article, the not-found article and their content remain intact; required parent categories are preserved as well. The content of these two articles can be removed for selected languages under “Content (slices)”.
clear_content_structure_all                    = Entire site structure
clear_content_delete_structure_all             = Delete entire site structure
clear_content_categories                       = Select categories
clear_content_categories_select                = Select categories
clear_content_category                         = Selected categories including subcategories
clear_content_category_help                    = This action is independent of the language selection. The selected categories are deleted completely in all languages, including articles, subcategories and slice history. Subcategories already covered by a selected parent are processed only once. Categories containing the site start or not-found article are protected.
clear_content_delete_category                  = Delete selected categories

clear_content_mass_articles_info               = This action is independent of the language selection. Regular articles are deleted in all languages including their slice history, but only directly within the selected categories. Category start articles, the site start article and the not-found article remain intact. Subcategories are not changed.
clear_content_mass_articles_date               = Optional cutoff date (articles only)
clear_content_mass_articles_date_help          = Leave the date empty to delete all matching articles. With a date, only articles whose latest modification in every language predates that day are deleted.
clear_content_delete_articles_category         = Delete matching articles
clear_content_preview_mass_category            = Category “{0}” [ID {1}]
clear_content_preview_mass_all_dates           = No cutoff date: all matching articles are included.
clear_content_preview_mass_cutoff              = Last modified before {0}.
clear_content_preview_mass_protected           = Category start articles, the site start article and the not-found article remain intact.

clear_content_legend_sync_files                = Developer or theme files
clear_content_sync_files_info                  = Only synchronization directories that actually exist are deleted. If the Theme add-on is installed, its existing theme/private/redaxo directory is included automatically. Developer and Theme configuration remain unchanged. Active synchronization may recreate the files later.
clear_content_sync_files                       = Existing synchronization directories
clear_content_delete_sync_files                = Delete Developer or Theme files
clear_content_preview_sync_unchanged           = Developer and theme synchronization and their settings remain unchanged.
clear_content_preview_sync_path                = Directory {0}: {1} files

clear_content_legend_media                     = Media pool
clear_content_media_categories                 = Select media categories
clear_content_media_categories_help            = Only the selected categories are removed. Their media and unselected subcategories remain intact and are moved to the nearest remaining parent category.
clear_content_delete_media_categories          = Delete selected media categories
clear_content_media_category_select            = Select media categories
clear_content_media_category_help              = All media records and files assigned directly to the selected categories are permanently deleted. The categories, their subcategories and media filed there remain intact.
clear_content_delete_media_category            = Delete media in selected categories
clear_content_preview_media_category           = Media category “{0}” [ID {1}]
clear_content_media_categories_empty           = No media categories exist, so category-based media actions are unavailable.

clear_content_legend_tables                    = YForm tables
clear_content_tables_info                      = Records in the selected tables and their associated YForm history entries are deleted. Table schemas, TableManager configuration and relation fields remain intact.
clear_content_tables_empty                     = No eligible YForm TableManager tables were found.
clear_content_tables_selection                 = Select tables
clear_content_tables_action                    = Selected tables
clear_content_delete_tables                    = Delete table contents
clear_content_drop_tables                      = Delete tables completely
clear_content_tables_drop_info                 = “Delete tables completely” also removes table schemas, TableManager configuration, YForm history, unambiguously identifiable relation tables and incoming YForm relation fields. Shared relation tables, protected tables or external foreign keys abort the entire action before the first schema change. References in custom PHP code or free-text fields cannot be detected automatically.

clear_content_preview_table                    = {0} [{1}]: {2} records
clear_content_preview_drop_table               = Table {0} will be deleted completely ({1} records).
clear_content_preview_drop_relation            = Relation field {0}.{1} referencing {2} will be removed.
clear_content_preview_drop_foreign_key         = Internal foreign key {0}.{1} will be removed before the tables are deleted.
clear_content_preview_drop_definitions         = {0} TableManager configuration(s) will be removed.
clear_content_preview_drop_history             = Associated YForm history entries will be removed.

clear_content_confirmation_checkbox            = I have reviewed the selection and created a current backup if required.
clear_content_confirmation                     = This action permanently deletes data and cannot be undone. Continue?
clear_content_preview_title                     = Dry-run result
clear_content_preview_status                    = Safe dry run
clear_content_preview_warning                   = No data has been changed yet. Review the result carefully before confirming the action.
clear_content_preview_action_label              = Action
clear_content_preview_count                     = Affected content/records
clear_content_preview_selection                 = Reviewed selection
clear_content_preview_category                  = Category “{0}” [ID {1}] will be deleted including its subcategories.
clear_content_preview_empty                     = The dry run found no records to delete.
clear_content_preview_empty_structure           = The selected tables contain no records. Their schemas and configuration will still be removed after confirmation.
clear_content_preview_empty_sync                = The synchronization directories contain no files. Existing empty target directories will still be removed after confirmation; synchronization settings remain unchanged.
clear_content_preview_back                      = Change selection
clear_content_execute                           = Execute reviewed action now
clear_content_success                          = Cleanup completed. Removed content/records/files: {0}.
clear_content_error_admin                      = Only administrators may run this action.
clear_content_error_confirmation               = Confirm the safety notice before deleting data.
clear_content_error_preview                     = A valid dry run is required before deletion. Start the dry run again.
clear_content_error_preview_changed             = The data changed after the dry run. Review the action again.
clear_content_error_action                     = The selected action is unknown.
clear_content_error_language                   = The selected language does not exist.
clear_content_error_languages_missing          = Select at least one language.
clear_content_error_modules_missing            = Select at least one module.
clear_content_error_module_invalid             = Module with ID {0} does not exist.
clear_content_error_category_missing           = Select at least one category.
clear_content_error_article_missing            = At least one selected article does not exist in a selected language.
clear_content_error_article_selection_missing  = Select at least one article.
clear_content_error_date_invalid               = The supplied cutoff date is invalid.
clear_content_error_category_invalid           = The selected category does not exist or cannot be deleted.
clear_content_error_category_protected         = This category contains the site start article or not-found article and therefore cannot be deleted completely.
clear_content_error_media_file                 = The media file “{0}” could not be deleted.
clear_content_error_media_category             = Select at least one existing media category.
clear_content_error_tables_missing             = Select at least one table.
clear_content_error_table_invalid              = Table “{0}” is not eligible for cleanup.
clear_content_error_shared_relation            = Relation table “{0}” is also used by unselected tables and cannot be removed safely.
clear_content_error_protected_relation         = Protected table “{0}” is configured as a relation table and cannot be removed.
clear_content_error_foreign_key                = The table is referenced by external foreign key “{2}” at {0}.{1} and cannot be removed safely.
clear_content_error_sync_delete                = Synchronization directory “{0}” could not be deleted completely.
