clear_content_legend_slices                    = Inhalte (Slices)
clear_content_languages_selection              = Sprachen auswählen
clear_content_languages_selection_help         = Die Auswahl gilt für die beiden sprachbezogenen Aktionen. „Inhalte dieser Sprachen löschen“ entfernt aktuelle und historische Slices aus allen Artikeln der ausgewählten Sprachen. Bei nur einer vorhandenen Sprache wird sie automatisch verwendet.
clear_content_slices_languages                 = Inhalte ausgewählter Sprachen
clear_content_delete_slices_language           = Inhalte dieser Sprachen löschen
clear_content_slices_article_language          = Artikel wählen
clear_content_articles_select                  = Bitte Artikel auswählen
clear_content_slices_article_language_help     = Bei den gewählten Artikeln werden aktuelle und historische Slices nur in den ausgewählten Sprachen entfernt. Die Artikel selbst und ihre Inhalte in anderen Sprachen bleiben erhalten.
clear_content_delete_slices_article_language   = Inhalte der gewählten Artikel löschen
clear_content_preview_article_language         = Artikel „{0}“ [ID {1}], Sprachen: {2}
clear_content_preview_languages                = Ausgewählte Sprachen: {0}
clear_content_slices_modules                   = Inhalte ausgewählter Module
clear_content_slices_modules_help              = Es werden alle eigenständigen Slices und erkannte verschachtelte Gridblock-Inhalte der ausgewählten Module in sämtlichen Artikeln, Sprachen und der Slice-Historie gelöscht. Die Module selbst bleiben erhalten.
clear_content_delete_slices_modules            = Inhalte dieser Module löschen
clear_content_preview_module                   = {0} [Modul {1}]: {2} eigenständige Slices, {3} verschachtelte Gridblock-Inhalte, {4} historische Gridblock-Inhalte

clear_content_legend_structure                 = Kategorien und Artikel
clear_content_actions                          = Aktionen
clear_content_structure_info                   = Diese Aktion ist unabhängig von der Sprachauswahl und löscht die Seitenstruktur in allen Sprachen. Der Website-Startartikel, der Fehlerartikel und ihre Inhalte bleiben erhalten; notwendige übergeordnete Kategorien werden ebenfalls nicht gelöscht. Die Inhalte dieser beiden Artikel können über „Inhalte (Slices)“ gezielt in den ausgewählten Sprachen entfernt werden.
clear_content_structure_all                    = Gesamte Seitenstruktur
clear_content_delete_structure_all             = Gesamte Seitenstruktur löschen
clear_content_categories                       = Kategorien auswählen
clear_content_categories_select                = Bitte Kategorien auswählen
clear_content_category                         = Ausgewählte Kategorien einschließlich Unterkategorien
clear_content_category_help                    = Diese Aktion ist unabhängig von der Sprachauswahl. Die ausgewählten Kategorien werden in allen Sprachen vollständig mit Artikeln, Unterkategorien und Slice-Historie gelöscht. Bereits durch eine ausgewählte Elternkategorie erfasste Unterkategorien werden nur einmal berücksichtigt. Kategorien mit Website-Start- oder Fehlerartikel sind geschützt.
clear_content_delete_category                  = Ausgewählte Kategorien löschen

clear_content_mass_articles_info               = Diese Aktion ist unabhängig von der Sprachauswahl. Gelöscht werden normale Artikel in allen Sprachen einschließlich ihrer Slice-Historie, jedoch nur direkt in den ausgewählten Kategorien. Kategorie-Startartikel, Website-Startartikel und Fehlerartikel bleiben erhalten. Unterkategorien werden nicht verändert.
clear_content_mass_articles_date               = Optionaler Stichtag (nur für Artikel)
clear_content_mass_articles_date_help          = Bleibt das Datum leer, werden alle passenden Artikel gelöscht. Mit Datum werden nur Artikel gelöscht, deren letzte Änderung in allen Sprachen vor diesem Tag liegt.
clear_content_delete_articles_category         = Passende Artikel löschen
clear_content_preview_mass_category            = Kategorie „{0}“ [ID {1}]
clear_content_preview_mass_all_dates           = Kein Stichtag: alle passenden Artikel werden berücksichtigt.
clear_content_preview_mass_cutoff              = Letzte Änderung vor dem {0}.
clear_content_preview_mass_protected           = Kategorie-Startartikel, Website-Startartikel und Fehlerartikel bleiben erhalten.

clear_content_legend_sync_files                = Developer- bzw. Theme-Dateien
clear_content_sync_files_info                  = Gelöscht werden nur tatsächlich vorhandene Synchronisationsordner. Ist das Theme-Add-on installiert, wird dessen vorhandener Ordner theme/private/redaxo automatisch berücksichtigt. Developer- und Theme-Konfiguration bleiben unverändert. Bei aktiver Synchronisation können die Dateien später erneut erzeugt werden.
clear_content_sync_files                       = Vorhandene Synchronisationsordner
clear_content_delete_sync_files                = Developer- bzw. Theme-Dateien löschen
clear_content_preview_sync_unchanged           = Developer- und Theme-Synchronisation sowie deren Einstellungen bleiben unverändert.
clear_content_preview_sync_path                = Ordner {0}: {1} Dateien

clear_content_legend_media                     = Medienpool
clear_content_media_categories                 = Medienkategorien auswählen
clear_content_media_categories_help            = Nur die ausgewählten Kategorien werden entfernt. Ihre Medien und nicht ausgewählte Unterkategorien bleiben erhalten und werden der nächsten vorhandenen übergeordneten Kategorie zugeordnet.
clear_content_delete_media_categories          = Ausgewählte Medienkategorien löschen
clear_content_media_category_select            = Bitte Medienkategorien auswählen
clear_content_media_category_help              = Es werden alle Medieneinträge und Dateien dauerhaft gelöscht, die direkt den ausgewählten Kategorien zugeordnet sind. Die Kategorien, ihre Unterkategorien und die dort einsortierten Medien bleiben erhalten.
clear_content_delete_media_category            = Medien der ausgewählten Kategorien löschen
clear_content_preview_media_category           = Medienkategorie „{0}“ [ID {1}]
clear_content_media_categories_empty           = Es sind keine Medienkategorien vorhanden. Daher stehen keine kategoriebasierten Medienaktionen zur Verfügung.

clear_content_legend_tables                    = YForm-Tabellen
clear_content_tables_info                      = Die Datensätze der ausgewählten Tabellen und ihre zugehörigen YForm-Historieneinträge werden gelöscht. Tabellenstruktur, TableManager-Konfiguration und Relationsfelder bleiben erhalten.
clear_content_tables_empty                     = Es wurden keine löschbaren YForm-TableManager-Tabellen gefunden.
clear_content_tables_selection                 = Tabellen auswählen
clear_content_tables_action                    = Ausgewählte Tabellen
clear_content_delete_tables                    = Tabelleninhalte löschen
clear_content_drop_tables                      = Tabellen vollständig löschen
clear_content_tables_drop_info                 = „Tabellen vollständig löschen“ entfernt zusätzlich Tabellenstruktur, TableManager-Konfiguration, YForm-Historie sowie eindeutig erkennbare Relationstabellen und eingehende YForm-Relationsfelder. Bei gemeinsam genutzten Relationstabellen, geschützten Tabellen oder externen Fremdschlüsseln wird die gesamte Aktion vor der ersten Schemaänderung abgebrochen. Verweise in eigenem PHP-Code oder freien Textfeldern können nicht automatisch erkannt werden.

clear_content_preview_table                    = {0} [{1}]: {2} Datensätze
clear_content_preview_drop_table               = Tabelle {0} wird vollständig gelöscht ({1} Datensätze).
clear_content_preview_drop_relation            = Relationsfeld {0}.{1} mit Verweis auf {2} wird entfernt.
clear_content_preview_drop_foreign_key         = Interner Fremdschlüssel {0}.{1} wird vor dem Löschen entfernt.
clear_content_preview_drop_definitions         = {0} TableManager-Konfiguration(en) werden entfernt.
clear_content_preview_drop_history             = Zugehörige Einträge der YForm-Historie werden entfernt.

clear_content_confirmation_checkbox            = Ich habe die Auswahl geprüft und bei Bedarf ein aktuelles Backup erstellt.
clear_content_confirmation                     = Diese Aktion löscht Daten dauerhaft und kann nicht rückgängig gemacht werden. Fortfahren?
clear_content_preview_title                     = Ergebnis des Testlaufs
clear_content_preview_status                    = Sicherer Testlauf
clear_content_preview_warning                   = Es wurden noch keine Daten verändert. Prüfe das Ergebnis sorgfältig, bevor du die Aktion bestätigst.
clear_content_preview_action_label              = Aktion
clear_content_preview_count                     = Betroffene Inhalte/Datensätze
clear_content_preview_selection                 = Geprüfte Auswahl
clear_content_preview_category                  = Kategorie „{0}“ [ID {1}] wird einschließlich Unterkategorien gelöscht.
clear_content_preview_empty                     = Der Testlauf hat keine zu löschenden Datensätze gefunden.
clear_content_preview_empty_structure           = Die ausgewählten Tabellen enthalten keine Datensätze. Tabellenstruktur und Konfiguration werden nach Bestätigung trotzdem entfernt.
clear_content_preview_empty_sync                = Die Synchronisationsordner enthalten keine Dateien. Vorhandene leere Zielordner werden nach Bestätigung trotzdem entfernt; Synchronisationseinstellungen bleiben unverändert.
clear_content_preview_back                      = Auswahl ändern
clear_content_execute                           = Geprüfte Aktion jetzt ausführen
clear_content_success                          = Die Bereinigung wurde abgeschlossen. Entfernte Inhalte/Datensätze/Dateien: {0}.
clear_content_error_admin                      = Diese Aktion darf nur von Administratoren ausgeführt werden.
clear_content_error_confirmation               = Bitte bestätige die Sicherheitsabfrage vor dem Löschen.
clear_content_error_preview                     = Vor dem Löschen ist ein gültiger Testlauf erforderlich. Bitte starte den Testlauf erneut.
clear_content_error_preview_changed             = Die Daten haben sich seit dem Testlauf geändert. Bitte prüfe die Aktion erneut.
clear_content_error_action                     = Die gewählte Aktion ist unbekannt.
clear_content_error_language                   = Die gewählte Sprache existiert nicht.
clear_content_error_languages_missing          = Bitte wähle mindestens eine Sprache aus.
clear_content_error_modules_missing            = Bitte wähle mindestens ein Modul aus.
clear_content_error_module_invalid             = Das Modul mit der ID {0} existiert nicht.
clear_content_error_category_missing           = Bitte wähle mindestens eine Kategorie aus.
clear_content_error_article_missing            = Mindestens einer der ausgewählten Artikel existiert in einer gewählten Sprache nicht.
clear_content_error_article_selection_missing  = Bitte wähle mindestens einen Artikel aus.
clear_content_error_date_invalid               = Der angegebene Stichtag ist ungültig.
clear_content_error_category_invalid           = Die gewählte Kategorie existiert nicht oder kann nicht gelöscht werden.
clear_content_error_category_protected         = Diese Kategorie enthält den Website-Startartikel oder den Fehlerartikel und kann deshalb nicht vollständig gelöscht werden.
clear_content_error_media_file                 = Die Mediendatei „{0}“ konnte nicht gelöscht werden.
clear_content_error_media_category             = Bitte wähle mindestens eine vorhandene Medienkategorie aus.
clear_content_error_tables_missing             = Bitte wähle mindestens eine Tabelle aus.
clear_content_error_table_invalid              = Die Tabelle „{0}“ ist nicht für die Bereinigung freigegeben.
clear_content_error_shared_relation            = Die Relationstabelle „{0}“ wird auch von nicht ausgewählten Tabellen verwendet und kann nicht sicher entfernt werden.
clear_content_error_protected_relation         = Die geschützte Tabelle „{0}“ ist als Relationstabelle eingebunden und kann nicht entfernt werden.
clear_content_error_foreign_key                = Die Tabelle wird über den externen Fremdschlüssel „{2}“ in {0}.{1} referenziert und kann nicht sicher entfernt werden.
clear_content_error_sync_delete                = Der Synchronisationsordner „{0}“ konnte nicht vollständig gelöscht werden.
clear_content_error_sync_path                  = Der Pfad „{0}“ ist kein freigegebener Synchronisationsordner.
